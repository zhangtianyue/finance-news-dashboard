{
  "name": "finance-news-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cross-market:import": "node scripts/import-cross-market-dashboard.mjs",
    "qdii:rotation": "node scripts/qdii-sp500-rotation.mjs",
    "qdii:rotation:empty": "node scripts/qdii-sp500-rotation.mjs --current-holding none",
    "qdii:mode:risk-on": "node scripts/qdii-sp500-rotation.mjs --set-risk-mode risk_on",
    "qdii:mode:neutral": "node scripts/qdii-sp500-rotation.mjs --set-risk-mode neutral",
    "qdii:mode:risk-off": "node scripts/qdii-sp500-rotation.mjs --set-risk-mode risk_off",
    "qdii:mode:symmetric": "node scripts/qdii-sp500-rotation.mjs --set-risk-mode symmetric",
    "qdii:rotation:test": "node scripts/qdii-sp500-rotation.mjs --self-test",
    "dca:metrics:test": "node --no-warnings scripts/dca-metrics-self-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.18.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
